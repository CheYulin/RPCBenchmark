+namespace {
+struct FixedOwnerState {
+    enum Registration : std::uint32_t { Empty, Publishing, Ready, Released };
+    struct alignas(64) Owner {
+        std::atomic<std::uint32_t> registration{Empty};
+        std::thread::id thread;
+        std::uint32_t tid = 0;
+        std::array<std::atomic<std::uint64_t>, 2> ended{};
+        std::atomic<bool> active{false};
