+    explicit FixedOwnerState(FixedOwnerPlan value, std::filesystem::path directory)
+        : plan(std::move(value)), output(std::move(directory)), owners(std::make_unique<Owner[]>(plan.Callers()))
+    {
+        if (!std::filesystem::is_directory(output) || std::filesystem::exists(output / "fixed-owner-plan.json"))
+            throw std::invalid_argument("fixed-owner output must be a fresh driver directory");
+        std::ofstream file(output / "fixed-owner-plan.json");
+        file << "{\"owner_stride\":" << plan.Callers() << ",\"warm_per_owner\":" << plan.Calls(1)
+             << ",\"measure_per_owner\":" << plan.Calls(2) << ",\"warm_planned\":" << plan.TotalCalls(1)
+             << ",\"measure_planned\":" << plan.TotalCalls(2) << ",\"rate\":" << plan.Rate()
+             << ",\"seed\":" << plan.Seed() << ",\"modulus\":" << plan.Modulus()
+             << ",\"max_selected_per_owner\":" << plan.MaxSelectedPerOwner()
+             << ",\"lent_array_bound_bytes\":" << plan.CaptureBytes()
+             << ",\"metadata_reserve_bytes\":" << plan.MetadataReserveBytes << "}\n";
+        file.close(); if (!file) throw std::runtime_error("fixed-owner plan write failed");
+    }
+    void Fail(int value = DS_CAPTURE_INVALID) noexcept { First(status, value); }
+    bool Register(std::size_t caller, std::uint32_t tid) noexcept
+    {
+        if (caller >= plan.Callers() || started.load() || !tid || tid != static_cast<std::uint32_t>(syscall(SYS_gettid))) {
+            Fail(DS_CAPTURE_OWNER); return false;
+        }
+        auto &owner = owners[caller]; std::uint32_t expected = Empty;
+        if (!owner.registration.compare_exchange_strong(expected, Publishing)) { Fail(DS_CAPTURE_OWNER); return false; }
+        owner.thread = std::this_thread::get_id(); owner.tid = tid;
+        owner.registration.store(Ready, std::memory_order_release); return true;
+    }
+    bool PrepareArm() noexcept
+    {
+        if (started.exchange(true) || status.load()) { Fail(); return false; }
+        for (std::size_t caller = 0; caller < plan.Callers(); ++caller) {
+            if (owners[caller].registration.load(std::memory_order_acquire) != Ready) { Fail(); return false; }
+            for (std::size_t other = 0; other < caller; ++other)
+                if (owners[other].tid == owners[caller].tid) { Fail(DS_CAPTURE_OWNER); return false; }
+        }
+        return true;
+    }
+    Owner *Current(std::size_t caller) noexcept
+    {
+        if (caller >= plan.Callers()) { Fail(DS_CAPTURE_OWNER); return nullptr; }
+        auto &owner = owners[caller];
+        if (owner.registration.load(std::memory_order_acquire) != Ready || owner.thread != std::this_thread::get_id()) {
+            Fail(DS_CAPTURE_OWNER); return nullptr;
+        }
+        return &owner;
+    }
+    bool Begin(std::size_t caller, std::uint64_t phase, std::uint64_t id,
+               std::uint64_t scheduled, std::uint64_t begin) noexcept
+    {
+        if (!plan.ValidateBegin(caller, phase, id) || !armed.load(std::memory_order_acquire) || !begin || scheduled > begin) {
+            Fail(); return false;
+        }
+        auto *owner = Current(caller); if (!owner) return false;
+        const auto warm = owner->ended[0].load(); const auto measured = owner->ended[1].load();
+        const auto next = phase == 1 ? warm : measured;
+        if (owner->active.load() || next >= plan.Calls(phase) || id / plan.Callers() != next
+            || (phase == 1 && measured) || (phase == 2 && warm != plan.Calls(1))) { Fail(); return false; }
+        owner->phase = phase; owner->begin = begin; owner->active.store(true, std::memory_order_release); return true;
+    }
+    bool End(std::size_t caller, std::uint64_t end, std::uint64_t validated, std::int32_t outcome) noexcept
+    {
+        auto *owner = Current(caller); if (!owner) return false;
+        if (!owner->active.load(std::memory_order_acquire)) { Fail(); return false; }
+        if (end < owner->begin || validated < end || outcome) Fail();
+        auto &count = owner->ended[owner->phase - 1]; count.store(count.load() + 1, std::memory_order_release);
+        owner->active.store(false, std::memory_order_release); return true;
+    }
+    bool Complete(bool released) const noexcept
+    {
+        for (std::size_t caller = 0; caller < plan.Callers(); ++caller) {
+            const auto &owner = owners[caller]; const auto registration = owner.registration.load(std::memory_order_acquire);
+            if ((released ? registration != Released : registration != Ready && registration != Released)
+                || owner.active.load(std::memory_order_acquire) || owner.ended[0].load() != plan.Calls(1)
+                || owner.ended[1].load() != plan.Calls(2)) return false;
+        }
+        return true;
+    }
+    void Drained(bool final) noexcept
+    {
+        if (final) { armed.store(false, std::memory_order_release); if (!Complete(false)) Fail(); sealed.store(true); return; }
+        for (std::size_t caller = 0; caller < plan.Callers(); ++caller) {
+            const auto &owner = owners[caller];
+            if (owner.active.load() || owner.ended[0].load() != plan.Calls(1) || owner.ended[1].load()) Fail();
+        }
+    }
+    bool CanRelease(std::size_t caller) noexcept
+    {
+        auto *owner = Current(caller); if (!owner) return false;
+        if (!sealed.load() || owner->active.load()) { Fail(); return false; } return true;
+    }
+    void Release(std::size_t caller) noexcept { owners[caller].registration.store(Released, std::memory_order_release); }
+    void Finish() { if (!Complete(true)) Fail(); }
+    void WriteFinal() const
+    {
+        std::ofstream file(output / "fixed-owner-final.json");
+        file << "{\"closed\":true,\"control_status\":" << status.load()
+             << ",\"all_ids_ended_and_owners_released\":" << (Complete(true) ? "true" : "false") << "}\n";
+        file.close(); if (!file) throw std::runtime_error("fixed-owner final write failed");
+    }
+    const FixedOwnerPlan plan;
+    const std::filesystem::path output;
+    std::unique_ptr<Owner[]> owners;
+    std::atomic<int> status{0};
+    std::atomic<bool> started{false}, armed{false}, sealed{false};
+};
+}
