module(name = "rpc_framework_lab")

bazel_dep(name = "brpc", version = "1.15.0")
bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "rules_proto", version = "6.0.2")

archive_override(
    module_name = "brpc",
    integrity = "sha256-C8jCrugQyW5sd4hvgo+/3zKuNTzpl+tG8ncsAIgBDDU=",
    strip_prefix = "apache-brpc-1.15.0-src",
    urls = [
        "https://archive.apache.org/dist/brpc/1.15.0/apache-brpc-1.15.0-src.tar.gz",
        "https://mirrors.aliyun.com/apache/brpc/1.15.0/apache-brpc-1.15.0-src.tar.gz",
    ],
)

# bRPC's registry overrides apply only when bRPC is the root module.
single_version_override(
    module_name = "leveldb",
    registry = "https://raw.githubusercontent.com/secretflow/bazel-registry/main",
    version = "1.23",
)
single_version_override(
    module_name = "openssl",
    registry = "https://raw.githubusercontent.com/secretflow/bazel-registry/main",
    version = "3.3.2.bcr.1",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "yalantinglibs",
    build_file = "//:yalantinglibs.BUILD.bazel",
    sha256 = "baa6b5c9ffcc0af8252742bba8f0fb9c6d37387c13b2ff5b26d29c6aaff6ee37",
    strip_prefix = "yalantinglibs-45c6463c0afbcc46262e373effa30635be3846a0",
    type = "tar.gz",
    urls = ["https://codeload.github.com/alibaba/yalantinglibs/tar.gz/45c6463c0afbcc46262e373effa30635be3846a0"],
)
